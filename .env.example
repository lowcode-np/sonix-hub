# copy to .env for local runs (never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
THAILLM_API_KEY=
THAILLM_MODEL=typhoon-s-thaillm-8b-instruct
THAILLM_BASE=http://thaillm.or.th/api/v1
LLM_ORDER=gemini,thaillm
# FEED_URL=https://<user>.github.io/<repo>/v1/xauusd.json

# --- server mode (python -m hub.server) ---
HOST=0.0.0.0
PORT=8080
# ไม่บังคับ: เว้นว่าง = ไม่ต้องส่ง ?k= ใน URL (ปลอดภัยพอถ้า bind 127.0.0.1 หรือจำกัด IP ใน firewall)
HUB_TOKEN=
HUB_STATE_DIR=public
READY_TIMEOUT=240
LOG_LEVEL=INFO
